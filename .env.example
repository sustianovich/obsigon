# Configuración local de Obsigon.
APP_HOST=127.0.0.1
APP_PORT=8000
APP_READ_HEADER_TIMEOUT_SECONDS=5
APP_IDLE_TIMEOUT_SECONDS=90
APP_SHUTDOWN_TIMEOUT_SECONDS=10
# Vacío por defecto: la UI se sirve empotrada en el binario. Para desarrollo,
# indica un directorio que contenga static/ y templates/index.html.
RAG_WEBUI_DIR=

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=gpt-oss:latest
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_KEEP_ALIVE=30m

# Vault autónomo incluido en este proyecto. Puede sustituirse por cualquier vault.
OBSIDIAN_VAULT_PATH=./vault_demo
# RAG_DATABASE_PATH=./data/rag_index.sqlite3

RAG_CHUNK_SIZE=1800
RAG_CHUNK_OVERLAP=250
RAG_EMBEDDING_WORKERS=3
RAG_EMBEDDING_PREFIX_SCHEME=auto
# HNSW puro Go y persistente. Desactivado mantiene el ranking coseno exacto.
RAG_ANN=false
RAG_ANN_M=16
RAG_ANN_EF_CONSTRUCTION=200
RAG_ANN_EF_SEARCH=64
RAG_PARENT_CHILD_CHUNKING=false
RAG_PARENT_CHUNK_SIZE=6000
RAG_CHILD_CHUNK_SIZE=700
RAG_CHILD_CHUNK_OVERLAP=100

RAG_TOP_K=6
RAG_MIN_SIMILARITY=0.30
RAG_MIN_RELATIVE_SCORE=0.62
RAG_MAX_OUTPUT_TOKENS=1800
RAG_HYBRID_SEARCH=true
RAG_HYBRID_RRF_K=60
RAG_HYBRID_SEMANTIC_WEIGHT=1.0
RAG_HYBRID_LEXICAL_WEIGHT=0.8
RAG_HYBRID_CANDIDATE_MULTIPLIER=4
RAG_MMR=true
RAG_MMR_LAMBDA=0.72
RAG_MAX_CHUNKS_PER_DOCUMENT=3

RAG_GRAPH_SEARCH=false
RAG_GRAPH_WEIGHT=0.5
RAG_GRAPH_MAX_HOPS=2
RAG_GRAPH_DECAY=0.5
RAG_GRAPH_BACKLINK_WEIGHT=0.7
RAG_GRAPH_SEED_DOCUMENTS=4
RAG_GRAPH_MAX_CANDIDATES=20

# Reranking local con el mismo modelo de chat de Ollama.
RAG_RERANK=false
RAG_RERANK_BACKEND=llm
RAG_RERANK_CANDIDATES=12
RAG_RERANK_WEIGHT=0.35
# Backend alternativo: runtime cross-encoder/ONNX local por HTTP loopback.
# RAG_CROSS_ENCODER_URL=http://127.0.0.1:9000
RAG_CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_CROSS_ENCODER_TIMEOUT_SECONDS=30

# Enrutado determinista por consulta. Las listas se separan con comas.
RAG_QUERY_ROUTING=false
RAG_QUERY_ROUTER_RELATIONAL_PATTERNS=relación entre,relacion entre,cómo se conecta,como se conecta,depende de,flujo entre,antes y después,antes y despues
RAG_QUERY_ROUTER_STRUCTURAL_TERMS=relación,relacion,dependencia,flujo,proceso,paso,enlace,conexión,conexion,ruta,circuito
RAG_QUERY_ROUTER_STRUCTURAL_THRESHOLD=2

# Fase 1: memoria sólo para reformular, lectura amplia tras el ranking y
# señales estructurales auditables de Obsidian.
RAG_QUERY_REWRITE=true
RAG_QUERY_REWRITE_CONTEXT_TOKENS=4096
RAG_QUERY_REWRITE_MAX_OUTPUT_TOKENS=512
RAG_QUERY_REWRITE_MAX_MEMORY_CHARS=6000
RAG_READ_LARGE=true
RAG_HUB_BOOST=true
RAG_HUB_BOOST_WEIGHT=0.08
RAG_RECENCY_BOOST=true
RAG_RECENCY_BOOST_WEIGHT=0.08

# Vigilancia automática del vault (desactivada por defecto).
RAG_WATCH=false
RAG_WATCH_RECONCILE_INTERVAL_MS=300000
RAG_WATCH_DEBOUNCE_MS=750

# Paginación acotada de conversaciones, turnos y telemetría histórica.
RAG_HISTORY_PAGE_SIZE=50
RAG_HISTORY_MAX_PAGE_SIZE=200

RAG_STREAMING=true

# Recuperación agéntica opt-in. Descompone la consulta, ejecuta herramientas
# locales sobre el índice/vault y conserva el Verificador + Redactor actuales.
RAG_AGENT_MODE=false
RAG_AGENT_MAX_ITERATIONS=4
# Presupuesto agregado de tokens de salida del planificador/agente de búsqueda.
RAG_AGENT_TOKEN_BUDGET=2200
RAG_AGENT_MAX_SUBQUESTIONS=3
RAG_AGENT_CONTEXT_TOKENS=8192
RAG_AGENT_MAX_OBSERVATION_CHARS=12000

RAG_VERIFIER_CONTEXT_TOKENS=8192
RAG_WRITER_CONTEXT_TOKENS=16384
RAG_VERIFIER_MAX_OUTPUT_TOKENS=600
RAG_VERIFIER_ABSTAIN_ON_INSUFFICIENT=false
RAG_MEMORY_SUMMARY_INTERVAL=10
RAG_MEMORY_RECENT_TURNS=4
RAG_MEMORY_MAX_CONTEXT_CHARS=12000
RAG_MEMORY_SUMMARY_MAX_INPUT_CHARS=40000
RAG_MEMORY_SUMMARY_MAX_TOKENS=700
RAG_PROJECT_MEMORY_MAX_CONTEXT_CHARS=6000
RAG_PROJECT_MEMORY_SUMMARY_INTERVAL=10
RAG_PROJECT_MEMORY_SUMMARY_MAX_INPUT_CHARS=40000
RAG_PROJECT_MEMORY_SUMMARY_MAX_TOKENS=700
